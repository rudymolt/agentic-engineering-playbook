{
  "$id": "https://playbook.local/delivery-pilot/canary/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "canary_id": {
      "type": "string"
    },
    "conclusion": {
      "enum": [
        "healthy",
        "unhealthy",
        "inconclusive"
      ]
    },
    "observations": {
      "type": "array"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "window": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "canary_id",
    "release_id",
    "artifact_digest",
    "observations",
    "policy_digest",
    "window",
    "conclusion"
  ],
  "title": "canary/v1",
  "type": "object"
}
