{
  "$id": "https://playbook.local/delivery-pilot/finding/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "class": {
      "type": "string"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "locator": {
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "severity": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "severity",
    "class",
    "evidence_digest",
    "locator",
    "status"
  ],
  "title": "finding/v1",
  "type": "object"
}
