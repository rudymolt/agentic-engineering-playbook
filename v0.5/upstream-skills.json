{
  "schema_version": 1,
  "_comment": "Single source of truth for every upstream or local skill the playbook names. Read through scripts/upstream_registry.py; see ADR 0001. Slice 1 first cut (2026-09-04): data only, no generated surfaces yet.",
  "packages": {
    "mattpocock-skills": {
      "kind": "upstream",
      "source": "https://github.com/mattpocock/skills",
      "adoption_level": "accelerator",
      "pin": {
        "kind": "tag",
        "value": "v1.3.1",
        "commit": "24fe0ef7737efae15c87225755e9f6f5965e4888",
        "verified": "2026-10-08"
      },
      "install": {
        "method": "skills-cli",
        "command": "npx skills@1.7.1 add https://github.com/mattpocock/skills/tree/v1.3.1",
        "lock_file": "~/.agents/.skill-lock.json",
        "roots": [
          ".claude/skills",
          ".codex/skills",
          ".agents/skills"
        ],
        "layout": "bucketed under skills/<bucket>/<name> upstream; flattened <name>/ by the skills CLI"
      },
      "harness_name_pattern": {
        "claude": "/{name}",
        "codex": "${name}"
      }
    },
    "gstack": {
      "kind": "upstream",
      "source": "https://github.com/garrytan/gstack",
      "adoption_level": "accelerator",
      "pin": {
        "kind": "commit+version",
        "value": "1.62.0.0",
        "commit": "d078622b73539fc1a7a27e709861e9b6b058ae98",
        "verified": "2026-09-08"
      },
      "install": {
        "method": "git-checkout",
        "checkout": "~/gstack",
        "version_file": "VERSION",
        "roots": [
          ".claude/skills/gstack",
          ".codex/skills"
        ],
        "layout": "one <name>/SKILL.md directory per skill at the checkout root; Codex copies are prefixed gstack-"
      },
      "harness_name_pattern": {
        "claude": "/{name}",
        "codex": "$gstack-{name}"
      }
    },
    "pstack": {
      "kind": "upstream",
      "source": "https://github.com/cursor/plugins/tree/main/pstack",
      "adoption_level": "source",
      "pin": {
        "kind": "commit",
        "commit": "93b00b89ef425a9c1bac0d0b317dfc49c930ac99",
        "verified": "2026-09-08"
      },
      "install": {
        "method": "none"
      },
      "watch": [
        "pstack/skills/**",
        "pstack/playbooks/**",
        "pstack/principles/**"
      ],
      "harness_name_pattern": {
        "claude": "/{name}"
      }
    },
    "playbook": {
      "kind": "local",
      "source": "v0.5/skills",
      "harness_name_pattern": {
        "claude": "/{name}",
        "codex": "${name}"
      }
    }
  },
